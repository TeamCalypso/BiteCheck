{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitecheck.dev/schemas/analyze.schema.json",
  "title": "BiteCheck AnalyzeResponse",
  "description": "Response shape for POST /v1/analyze. Single source of truth for backend, web app and extension.",
  "type": "object",
  "required": ["requestId", "asin", "cached", "generatedAt", "product", "verdict", "findings", "disclaimer"],
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "description": "UUID. Pass to POST /v1/grievance to draft a complaint from this analysis."
    },
    "asin": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
    "cached": {
      "type": "boolean",
      "description": "True when served from DynamoDB without re-running RAG."
    },
    "generatedAt": { "type": "string", "format": "date-time" },

    "product": {
      "type": "object",
      "required": ["brand", "name", "category", "isFoodProduct"],
      "additionalProperties": false,
      "properties": {
        "brand": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "spices_blends",
            "supplements_protein",
            "dairy_perishable",
            "packaged_snacks",
            "beverages",
            "infant_food",
            "oils_fats",
            "staples_grains",
            "confectionery",
            "ready_to_eat",
            "other_food",
            "non_food"
          ]
        },
        "netQuantity": { "type": ["string", "null"] },
        "fssaiLicense": {
          "type": ["string", "null"],
          "description": "14-digit FSSAI licence number if declared on the listing."
        },
        "isFoodProduct": {
          "type": "boolean",
          "description": "False short-circuits the analysis; UI shows the not-food state."
        },
        "imageUrl": { "type": ["string", "null"] }
      }
    },

    "verdict": {
      "type": "object",
      "required": ["status", "score", "headline", "summary"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["CRITICAL", "WARNING", "CAUTION", "CLEAR", "NO_DATA"]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Safety score. 100 = no adverse records found. Drives the gauge."
        },
        "headline": { "type": "string", "maxLength": 120 },
        "summary": { "type": "string", "description": "2-3 plain-language sentences." }
      }
    },

    "findings": {
      "type": "array",
      "description": "Empty for CLEAR and NO_DATA. Every entry must be grounded in a retrieved chunk.",
      "items": {
        "type": "object",
        "required": ["id", "severity", "type", "scope", "title", "detail", "citations"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "INFO"]
          },
          "type": {
            "type": "string",
            "enum": [
              "CONTAMINANT",
              "RECALL",
              "LABEL_CLAIM",
              "ADDITIVE",
              "LICENSE",
              "COLD_CHAIN",
              "ADJUDICATION"
            ]
          },
          "scope": {
            "type": "string",
            "enum": ["BRAND", "PRODUCT", "BATCH", "CATEGORY"],
            "description": "How far the finding reaches. BATCH means check your own package."
          },
          "title": { "type": "string", "maxLength": 140 },
          "detail": { "type": "string" },
          "batches": { "type": "array", "items": { "type": "string" } },
          "citations": {
            "type": "array",
            "minItems": 1,
            "description": "minItems 1 is deliberate: a finding without a source must not exist.",
            "items": {
              "type": "object",
              "required": ["label", "issuer"],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "description": "Human-readable reference, e.g. RASFF 2024.2893."
                },
                "issuer": {
                  "type": "string",
                  "description": "e.g. FSSAI, EU RASFF, US FDA, HK CFS, Singapore SFA, NCDRC, CSE."
                },
                "date": { "type": ["string", "null"] },
                "sourceUrl": { "type": ["string", "null"] },
                "s3Uri": { "type": ["string", "null"] },
                "excerpt": {
                  "type": ["string", "null"],
                  "description": "Verbatim snippet from the retrieved chunk."
                }
              }
            }
          }
        }
      }
    },

    "nutrition": {
      "type": ["object", "null"],
      "description": "Null when no nutrition data could be resolved. macros[] drives the web app particle swarm.",
      "required": ["basis", "confidence", "source", "macros"],
      "additionalProperties": false,
      "properties": {
        "basis": { "type": "string", "enum": ["per_100g", "per_100ml"] },
        "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "source": {
          "type": "string",
          "enum": ["amazon_label", "openfoodfacts", "catalog", "ai_estimate", "none"]
        },
        "macros": {
          "type": "array",
          "description": "pct values sum to 100. An 'other' entry absorbs the unaccounted remainder so the swarm always partitions cleanly.",
          "items": {
            "type": "object",
            "required": ["key", "label", "grams", "pct", "class"],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "protein",
                  "carbohydrate",
                  "sugar",
                  "fat",
                  "saturated_fat",
                  "fiber",
                  "sodium",
                  "other"
                ]
              },
              "label": { "type": "string" },
              "grams": { "type": "number", "minimum": 0 },
              "pct": { "type": "number", "minimum": 0, "maximum": 100 },
              "class": {
                "type": "string",
                "enum": ["GOOD", "NEUTRAL", "WATCH", "UNKNOWN"]
              }
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "label"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "CLAIM_MISMATCH",
                  "ADDED_SUGAR_HIGH",
                  "SODIUM_HIGH",
                  "SATFAT_HIGH",
                  "ULTRA_PROCESSED",
                  "INCOMPLETE_LABEL",
                  "AI_ESTIMATED_NUTRITION"
                ]
              },
              "label": { "type": "string" }
            }
          }
        },
        "additives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "risk"],
            "additionalProperties": false,
            "properties": {
              "ins": {
                "type": ["string", "null"],
                "description": "INS code, e.g. INS 951."
              },
              "name": { "type": "string" },
              "risk": { "type": "string", "enum": ["OK", "WATCH", "AVOID"] }
            }
          }
        },
        "novaGroup": { "type": ["integer", "null"], "minimum": 1, "maximum": 4 }
      }
    },

    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["brand", "name", "why"],
        "additionalProperties": false,
        "properties": {
          "brand": { "type": "string" },
          "name": { "type": "string" },
          "why": { "type": "string" },
          "asin": { "type": ["string", "null"] }
        }
      }
    },

    "grievance": {
      "type": "object",
      "required": ["eligible"],
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "type": "boolean",
          "description": "True when at least one CRITICAL or HIGH finding exists."
        },
        "reason": { "type": ["string", "null"] }
      }
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latencyMs": { "type": "integer" },
        "chunksRetrieved": { "type": "integer" },
        "findingsDropped": {
          "type": "integer",
          "description": "Ungrounded findings removed by the grounding guard. Surfaced for transparency."
        },
        "modelId": { "type": ["string", "null"] },
        "nutritionSource": { "type": ["string", "null"] }
      }
    },

    "disclaimer": { "type": "string" }
  }
}
